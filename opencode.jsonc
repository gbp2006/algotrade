  // ==== SYNCED PROVIDERS END ====

  // Проект песочницы алготрейдинга. Запуск — алиас `algo` (изолированный
  // XDG-профиль, своя БД сессий и свой фоновый сервис).

  "mcp": {
    "servers": {
      // Свой индекс истории: notes.md сессий, PROGRESS.md, docs, reports.
      "memory": {
        "type": "local",
        "command": ["python3", "/mnt/DiskD/opencode-algo/infra/db/memory.py", "--mcp"],
        "environment": {
          "OC_MEMORY_ROOT": "/mnt/DiskD/opencode-algo",
          "OC_MEMORY_SESSIONS": "sessions"
        }
      },
      // Локальный поиск без ключей (Bing/Google News RSS) — то же имя, что
      // в хабе, чтобы инструменты назывались одинаково в обеих песочницах.
      "websearch-local": {
        "type": "local",
        "command": ["node", "/mnt/DiskD/opencode-algo/infra/mcp/websearch/server.js"]
      },
      // Exa: семантический поиск и чтение страниц (web_search_exa,
      // web_fetch_exa, agent_run). Ключ подставляется из окружения.
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },
      // Брокер Финам: котировки, портфель, заявки. Только в алго-песочнице.
      "finam-mcp": {
        "type": "remote",
        "url": "https://mcp.finam.ru/sk_cX7zrq5h7Fs0BRGrRdvm3uHMPA4pYGFY05fvngYnIkY"
      },
      // OsEngine: локальный терминал под Wine, MCP-хост на :6500.
      // Ключ — публичный дефолт OsEngine для loopback, не секрет.
      // Только исследования: не эталон (ADR 18.11) и без выхода в контур (ADR 23.11).
      "osengine": {
        "type": "remote",
        "url": "http://localhost:6500/api/v2/mcp",
        "headers": {
          "X-Api-Key": "osengine-mcp-default-key"
        }
      }
    }
  },

  "permissions": [
    // В песочнице доступны только два рабочих скилла, общие — скрыты.
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "session-workflow", "effect": "allow" },
    { "action": "skill", "resource": "memory-index", "effect": "allow" },

    // Данные рынка — только через скрипты, не инструментами чтения.
    { "action": "read", "resource": "/mnt/DiskD/MOEX/**", "effect": "deny" },
    { "action": "edit", "resource": "/mnt/DiskD/MOEX/**", "effect": "deny" },
    { "action": "edit", "resource": "data/**", "effect": "deny" }
  ]
}
