  // ==== SYNCED PROVIDERS END ====

  // Проект песочницы алготрейдинга. Запуск — алиас `algo` (изолированный
  // XDG-профиль, своя БД сессий и свой фоновый сервис).

  /*__MCP__*/

  "permissions": [
    // В песочнице доступны только два рабочих скилла, общие — скрыты.
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "session-workflow", "effect": "allow" },
    { "action": "skill", "resource": "memory-index", "effect": "allow" },
    // Finam Trade API Skill (установлен в .agents/skills/trade-api).
    { "action": "skill", "resource": "trade-api", "effect": "allow" },

    // Данные рынка — только через скрипты, не инструментами чтения.
    { "action": "read", "resource": "/mnt/DiskD/MOEX/**", "effect": "deny" },
    { "action": "edit", "resource": "/mnt/DiskD/MOEX/**", "effect": "deny" },
    { "action": "edit", "resource": "data/**", "effect": "deny" }
  ]
}
