{
  // ПРОФИЛЬ: __PROFILE__
  "$schema": "https://opencode.ai/config.json",

  // Встроенный веб-поиск OpenCode: ключ TAVILY_API_KEY берётся из окружения
  // сервиса (systemd user environment), в конфиг секрет не пишем.
  "websearch": {
    "provider": "tavily"
  },

  // Контекст: компактировать заранее, а не у лимита (буфер 35% = ~65% окна).
  // Плюс scripts/94_context_cleanup.py делает принудительный /compact для
  // крупных активных сессий каждые 4 часа (automation в профиле algo).
  "compaction": {
    "auto": true,
    "background": true,
    "keep": { "tokens": 12000 },
    "buffer": "35%"
  },
  // Длинные выходы инструментов режем: детали — в reports/, в чат только путь.
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16000
  },

