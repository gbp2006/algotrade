[Unit]
Description=Algo internal scheduler (shadow until gates pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zt
WorkingDirectory=/home/zt/algotrading
Environment=ALGO_SCHEDULER_SHADOW=1
ExecStart=/home/zt/algotrading/.venv/bin/python -m algo.scheduler
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
