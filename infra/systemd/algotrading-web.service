[Unit]
Description=Algo dashboard (FastAPI + React WebUI)
Requires=postgresql.service
After=network.target postgresql.service

[Service]
Type=simple
User=zt
WorkingDirectory=/home/zt/algotrading
Environment=PYTHONUNBUFFERED=1
# Привилегированный порт 80 без запуска сервиса от root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/zt/algotrading/.venv/bin/python -m uvicorn web.app:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=5
StandardOutput=append:/home/zt/algotrading/results/web.log
StandardError=append:/home/zt/algotrading/results/web.log

[Install]
WantedBy=multi-user.target
